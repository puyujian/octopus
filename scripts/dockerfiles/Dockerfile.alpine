FROM alpine

ARG TARGETPLATFORM
ENV TZ=Asia/Shanghai

RUN apk add --no-cache alpine-conf ca-certificates su-exec && \
    /usr/sbin/setup-timezone -z Asia/Shanghai && \
    apk del alpine-conf && \
    rm -rf /var/cache/apk/* && \
    mkdir -p /app

COPY build/docker/${TARGETPLATFORM}/octopus /app/octopus
COPY scripts/dockerfiles/entrypoint.sh /entrypoint.sh

# Fail the image build if the binary cannot run in Alpine (e.g. a glibc build).
RUN chmod +x /entrypoint.sh /app/octopus && /app/octopus --help > /dev/null

CMD ["/entrypoint.sh"]
